{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",

        "strict": true,
        "noImplicitAny": true,
        "strictNullChecks": true,

        "esModuleInterop": true,
        "resolveJsonModule": true,

        "rootDir": "./src",
        "outDir": "./dist",

        "types": ["node"]
    },
    "include": ["src"]
}